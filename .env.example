# Server-side API key for Google Gemini generative AI calls
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini model identifier (Current official Google GenAI model: gemini-2.5-flash; supported alternative: gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional server-side API key for Groq fast inference fallback provider
GROQ_API_KEY=your_groq_api_key_here

# Active LLM provider selection (gemini or groq)
LLM_PROVIDER=gemini

# Server-side Google Maps API key with IP restriction for Places and Routes Web APIs
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key_here

# Client-side Google Maps JavaScript API key restricted by HTTP referrers
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_public_client_key_here

# Firebase project ID for Firestore database and Admin SDK operations
FIREBASE_PROJECT_ID=puneri-safar-dev

# Firebase service account client email for Admin SDK authentication
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@puneri-safar-dev.iam.gserviceaccount.com

# Firebase service account private key in PEM format (escaped newlines supported)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3...\n-----END PRIVATE KEY-----\n"

# Runtime environment (development | test | production)
NODE_ENV=development
